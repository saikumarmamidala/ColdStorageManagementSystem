@model IEnumerable<MyFirstProj.Models.Payment>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>
<style>
    table {
        font-family: Arial, Helvetica, sans-serif;
        border-collapse: collapse;
        width: 100%;
    }

         td,  th {
            border: 1px solid #ddd;
            padding: 6px;
        }

         tr:nth-child(even) {
            background-color: #f2f2f2;
        }

         tr:hover {
            background-color: #ddd;
        }

    th {
        padding-top: 20px;
        padding-bottom: 20px;
        text-align: left;

        background-color: #034f84;
         color: white;
    }
</style>
<body style="background-color:#deeaee">
    <p>
        @Html.ActionLink("Create New", "Create")
    </p>
    <table class="table">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Customer.CustomerName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PaymentType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PaymentAmount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PaymentDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PaymentTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PaymentAdvance)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PaymentDue)
            </th>
            <th>Edit Options</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Customer.CustomerName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PaymentType)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PaymentAmount)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PaymentDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PaymentTime)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PaymentAdvance)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PaymentDue)
                </td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.PaymentID }) |
                    @Html.ActionLink("Details", "Details", new { id = item.PaymentID }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.PaymentID })
                </td>
            </tr>
        }

    </table>
</body>