@model MyFirstProj.Models.Admin


@{
    ViewBag.Title = "Admin";
}

@using (Html.BeginForm("Admin", "Home", FormMethod.Post))
{
    
    <html>
<head>
    <title></title>
    <style>
        div.a {
            position: relative;
            width: 400px;
            height: 200px;
        }
        .b2 {
            width: 150px;
            height: 40px;
            left: 970px;
            top: 100px;
            background: #2F3C7E;
            color: white;
            position: absolute;
            z-index: 20;
            cursor: pointer;
            font-size: 18px;
        }
    </style>
</head>
<body style="background-color: #FFFFFF; ">
    <div><img class="bg" style="width:600px ;height:200px" src="data:text/plain;base64," /></div>

    <table>
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <tr>
            <td style="text-align: center; ">
                <h2 style="text-align: center; ">   @Html.LabelFor(a => a.AdminID)</h2>

            </td>
            <td style="  text-align: center; ">
                <h2 style="text-align: center; ">@Html.TextBoxFor(a => a.AdminID)</h2>
                @Html.ValidationMessageFor(a => a.AdminID, "", new { @class = "text-danger" })
            </td>
        </tr>
       <tr>
            <td style=" text-align: center; ">
                <h2 style="text-align: center; ">@Html.LabelFor(a => a.AdminPwd)</h2>
            </td>
            <td style="  text-align: center; ">
                <h2 style="text-align: center; ">@Html.PasswordFor(a => a.AdminPwd)</h2>
                @Html.ValidationMessageFor(a => a.AdminPwd, "", new { @class = "text-danger" })
            </td>
        </tr> 
        <tr>
            <td style=" text-align: center; ">
                <input type="submit" value="Login" />
            </td>
        </tr>

    

    </table>
    <div style="text-align:center;"><button type="button" class="b2" onclick="location.href='@Url.Action( "Index", "Home")'">Logout</button></div>
</body>
</html>

}


