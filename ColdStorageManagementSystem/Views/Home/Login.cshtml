@model MyFirstProj.Models.Login

@{
    ViewBag.Title = "Login";
}

<h2> </h2>
@using(Html.BeginForm("Login","Home",FormMethod.Post))
{
    <html>
<head>
    <title></title>
    <style>
        .b {
            background-color: #F0F8FF;
        }
        div.a {
            position: relative;
            width: 800px;
            height: 800px;
            
        }
       
    </style>
</head>
<body class="b">
    <div><img class="a" style="width:1200px ;height:200px" src="data:image/jpg;base64," /></div>

    <table>
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        

        <tr>
            <td style="text-align: center; ">
                <h2 style=" text-align: center; ">@Html.LabelFor(a => a.LoginID)</h2>

            </td>
            <td style="  text-align: center; ">
                <h2 style=" text-align: center; ">@Html.TextBoxFor(a => a.LoginID)</h2>
                @Html.ValidationMessageFor(a => a.LoginID, "", new { @class = "text-danger" })
                
            </td>
        </tr>
        <tr>
            <td style=" text-align: center; ">
                <h2 style=" text-align: center; "> @Html.LabelFor(a => a.LoginPwd)</h2>
            </td>
            <td style="  text-align: center; ">
                <h2 style=" text-align: center; "> @Html.PasswordFor(a => a.LoginPwd)</h2>
               @Html.ValidationMessageFor(a =>a.LoginPwd, " ", new { @class = "greyfontMedError" })
            </td>
        </tr>
        <tr>
            <td style=" text-align: center; ">
                <input type="submit" value="Login" />
            </td>
        </tr>

       

    </table>
   </body>
</html>


    
}

